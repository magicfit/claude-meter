{
  "name": "@magicfit/claude-meter",
  "version": "0.1.0",
  "description": "Cost-tracking wrapper around the Anthropic SDK. Records token usage + cost to a central Supabase table for org-wide spend visibility.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicfit/claude-meter.git"
  },
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
